PI_FIREWALL_BACKEND=mock
# To use local Ollama, set the backend to ollama and name an installed model.
# PI_FIREWALL_OLLAMA_MODEL=
# PI_FIREWALL_DB=backend/generated/firewall.sqlite3
# PI_FIREWALL_EMBEDDING_MODEL=
# Optional local Responses gateway upstream, for example http://127.0.0.1:9010.
# PI_FIREWALL_RESPONSES_UPSTREAM=
# Optional operator-controlled folder containing guarded .txt, .md, or .html notes.
# PI_FIREWALL_NOTES_DIR=
# Optional trusted root for actions inspected by the native tool hook.
# PI_FIREWALL_ACTION_ROOT=
